const { expect } = require('@playwright/test');

async function safeClick(page, target, timeout = 15000) {
  const el = typeof target === 'string' ? page.locator(target) : target;
  await el.waitFor({ state: 'visible', timeout });
  await expect(el).toBeEnabled({ timeout });
  await el.click({ timeout });
}

async function safeType(el, text) {
  await el.waitFor({ state: 'visible' });
  await el.type(text);
}

async function safeSelect(el, option) {
  await el.scrollIntoViewIfNeeded().catch(() => {});
  await el.waitFor({ state: 'visible' });
  await el.selectOption(option);
}

async function clickOkWhenEnabled(page, timeout = 15000) {
  const ok = page.locator("//span[normalize-space()='OK']");
  await ok.waitFor({ state: 'visible', timeout });
  await expect(ok).toBeEnabled({ timeout });
  await ok.click();
  await ok.waitFor({ state: 'detached', timeout }).catch(() => {});
}

// Toolbar action buttons (Allocate StockNumber, Allocate Barcodes, Save&Submit)
// are real <button> elements — role-based lookup is more reliable here than
// a text/tag XPath, which breaks if the internal markup shifts slightly.
async function clickToolbarButton(page, name, timeout = 15000) {
  const btn = page.getByRole('button', { name: new RegExp(name) });
  await btn.waitFor({ state: 'visible', timeout });
  await expect(btn).toBeEnabled({ timeout });
  await btn.click({ timeout });
}

module.exports = { safeClick, safeType, safeSelect, clickOkWhenEnabled, clickToolbarButton };
